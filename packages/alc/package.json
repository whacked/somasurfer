{
  "name": "@gstack/alc",
  "version": "0.2.0",
  "description": "ALC-1: Anatomical Location Code. Short, human-transcribable, hierarchical addresses for locations in the human body and brain.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./dist/alc.js",
      "default": "./src/index.ts"
    },
    "./bundle": "./dist/alc.js",
    "./esm/*": "./dist/esm/*",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": false,
  "atlas": {
    "licenceClass": "code"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test 'test/*.test.ts'",
    "probe": "node test/healpix.probe.mjs",
    "measure": "node test/measure.mjs",
    "fuzz": "node --test test/fuzz.test.ts",
    "fuzz:soak": "ALC_FUZZ_ITERATIONS=400000 node --test test/fuzz.test.ts",
    "guard:equality": "node --test test/equality-guard.test.ts",
    "accept:templates": "node --test test/template-acceptance.test.ts",
    "audit:print": "node --experimental-strip-types test/admissibility.sweep.mjs",
    "audit:report": "npm run -s audit:print > ../../docs/alc-1-admissibility.md"
  },
  "license": "Apache-2.0"
}
