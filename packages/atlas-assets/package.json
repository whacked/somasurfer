{
  "name": "@gstack/atlas-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas geometry, textures and label sets. Separately licensed from the code — see ./LICENSE and ./ATTRIBUTION.md.",
  "atlas": {
    "licenceClass": "asset",
    "licenceStatus": "pending",
    "licenceDecision": "DOG-2 D1 (mesh licence)",
    "attribution": "./attribution.json",
    "payloadDirs": ["geometry", "templates", "labels"]
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "check": "node ../../tools/check-licence-separation.mjs",
    "geometry:make": "node ../../tools/make-placeholder-geometry.mjs",
    "attribution:print": "node ../../tools/render-attribution.mjs",
    "attribution:report": "npm run -s attribution:print > ATTRIBUTION.md"
  }
}
