{
  "name": "@gstack/atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Linked 3D Atlas Explorer \u2014 build and CI spine.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.21.0"
  },
  "workspaces": [
    "packages/alc",
    "packages/atlas-qa",
    "packages/atlas-web"
  ],
  "scripts": {
    "ci": "npm run check:node && npm run test:counted && npm run audit:check && npm run audit:template && npm run check:licences && npm run build && npm run check:licences && npm run perf:check && npm run verify:gates",
    "check:node": "node tools/check-node-version.mjs",
    "test:counted": "node tools/check-test-count.mjs",
    "audit:check": "node tools/check-audit-drift.mjs",
    "audit:template": "node tools/audit-real-template.mjs",
    "check:licences": "node tools/check-licence-separation.mjs",
    "build": "node packages/atlas-web/build.mjs",
    "perf:check": "node tools/perf-budget.mjs",
    "verify:gates": "node tools/verify-gates.mjs",
    "qa:journey": "node packages/atlas-qa/bin/qa-journey.mjs",
    "qa:negative-control": "node packages/atlas-qa/bin/qa-journey.mjs --negative-control"
  }
}
